# metrics-server riscv64 自建版
# 官方 Dockerfile 构建阶段(golang + CGO_ENABLED=0 go build)天然可交叉编译；
# 仅最终基础镜像 gcr.io/distroless/static 无 riscv64 变体，改用 alpine:3.20。
# 构建阶段钉在 --platform=$BUILDPLATFORM，在宿主架构上直接 GOARCH=riscv64 交叉编译(快)；
# 仅最终阶段运行于 riscv64。
ARG GO_VERSION=1.22.5
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG GIT_COMMIT=unknown
ARG GIT_TAG=v0.7.2
ARG BUILD_DATE=unknown
WORKDIR /go/src/sigs.k8s.io/metrics-server
COPY go.mod go.sum ./
RUN go mod download
COPY pkg pkg
COPY cmd cmd
RUN CGO_ENABLED=0 GOOS=linux GOARCH=riscv64 go build -mod=readonly -trimpath \
    -ldflags "-w -X sigs.k8s.io/metrics-server/pkg/version.gitVersion=${GIT_TAG} \
    -X sigs.k8s.io/metrics-server/pkg/version.gitCommit=${GIT_COMMIT} \
    -X sigs.k8s.io/metrics-server/pkg/version.buildDate=${BUILD_DATE}" \
    -o metrics-server sigs.k8s.io/metrics-server/cmd/metrics-server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /go/src/sigs.k8s.io/metrics-server/metrics-server /metrics-server
USER 65534
ENTRYPOINT ["/metrics-server"]
