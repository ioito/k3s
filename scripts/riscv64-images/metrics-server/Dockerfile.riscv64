# metrics-server v0.6.3 riscv64 构建
#
# 官方流程（golang + make metrics-server ARCH=riscv64，Makefile 内置 GOARCH/CGO_ENABLED=0
# 交叉编译）适配：
#   1) 官方在容器内 COPY 源码（构建上下文不含源码）-> 构建期 git clone 上游 v0.6.3
#   2) 官方 runtime 用 gcr.io/distroless/static（无 riscv64 变体）-> 换 alpine
#   3) 官方基础镜像 golang:1.19.7 -> 用有 riscv64 变体的 golang:1.22.8-alpine3.19
#      （Go 向后兼容，v0.6.3 代码可编译）
ARG GOLANG=golang:1.22.8-alpine3.19
FROM --platform=$BUILDPLATFORM ${GOLANG} as build
WORKDIR /go/src/sigs.k8s.io/metrics-server
ARG PROXY=
ARG GOPROXY=https://proxy.golang.org,direct
ENV http_proxy=$PROXY https_proxy=$PROXY HTTP_PROXY=$PROXY HTTPS_PROXY=$PROXY \
    GOPROXY=$GOPROXY
RUN apk add -U --no-cache git make ca-certificates \
 && git -c http.sslVerify=false clone --depth 1 --branch v0.6.3 https://github.com/kubernetes-sigs/metrics-server . \
 && make metrics-server ARCH=riscv64

FROM --platform=$TARGETPLATFORM alpine:3.20
RUN apk add -U --no-cache ca-certificates
COPY --from=build /go/src/sigs.k8s.io/metrics-server/metrics-server /
USER 65534
ENTRYPOINT ["/metrics-server"]
